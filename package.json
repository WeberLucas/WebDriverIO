{
  "name": "webdriverIO",
  "type": "module",
  "devDependencies": {
    "allure-commandline": "^2.34.1",
    "@wdio/allure-reporter": "^9.27.1",
    "@wdio/appium-service": "^9.17.0",
    "@wdio/cli": "^9.17.1",
    "@wdio/local-runner": "^9.17.0",
    "@wdio/mocha-framework": "^9.17.0",
    "@wdio/spec-reporter": "^9.17.0",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^4.2.5"
  },
  "scripts": {
    "test": "wdio run ./wdio.conf.cjs",
    "wdio": "wdio run ./wdio.conf.cjs",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  }
}
